    "api_prefixes": [
      "/api/approval-history",
      "/api/approval-queue",
      "/api/case-batch",
      "/api/case-changes",
      "/api/completion-notes",
      "/api/next-quote-no",
      "/api/quotations",
      "/api/sales-orders"
