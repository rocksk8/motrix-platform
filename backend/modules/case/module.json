    "probes": [
      "/api/quotations",
      "/api/approval-queue",
      "/api/approval-queue/count",
      "/api/approval-history",
      "/api/sales-orders"
    ]
  },
  "pages": [
    {
      "path": "quotations.html",
      "menu": {
        "group": "business",
        "label": "報價單",
        "order": 40,
        "perm": [
          "quotation"
        ],
        "active": [
          "quotations.html",
          "quotation-form.html"
        ],
        "badge": "sb-mod-quotation"
