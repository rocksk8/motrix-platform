        "class": "T1"
      },
      {
        "name": "case_updates",
        "class": "T1"
      },
      {
        "name": "case_action_items",
        "class": "T1"
      },
      {
        "name": "case_change_requests",
        "class": "T1"
      },
      {
        "name": "case_extra_expenses",
        "class": "T1"
      },
      {
        "name": "completion_notes",
        "class": "T1"
      }
    ],
    "files": []
  },
  "customization": {
    "schema": 1,
    "fields": {},
    "pages": [],
    "outputs": []
