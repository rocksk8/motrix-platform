{
  "key": "supply",
  "name": "採購・庫存・出貨",
  "version": "1.0.34",
  "core": ">=1.0,<2.0",
  "license_key": "supply",
  "permissions": [
    "procurement",
    "inventory",
    "shipping_export_log"
  ],
  "permissions_note": "procurement 同時管 L1 的料號主檔（routers/parts.py）；出貨單另認 case_manage／quotation（案件頁與簽核佇列）",
  "tables": [
    "suppliers",
    "stock_items",
    "stock_batches",
    "purchase_suggestion_status",
    "shipping_notes"
  ],
  "tables_note": "表由凍結的 V9 migration 建立（CORE-SPEC §6）；本模組尚無自有 migration。本模組不在時表仍在：M01 案件查詢、M08 儀表板、L1 料號／搜尋／備份照樣讀得到（唯讀）",
  "data": {
    "tables": [
      {
        "name": "suppliers",
        "class": "T1"
      },
      {
        "name": "stock_items",
        "class": "T1"
      },
      {
        "name": "stock_batches",
        "class": "T1"
      },
      {
        "name": "purchase_suggestion_status",
        "class": "T1"
      },
      {
        "name": "shipping_notes",
        "class": "T1"
      }
    ],
    "files": []
  },
  "customization": {
    "schema": 1,
    "fields": {
      "supplier": [
        {"key": "name", "label": "公司名稱", "core": true},
        {"key": "alias", "label": "內部簡稱", "core": false},
        {"key": "taxId", "label": "統一編號", "core": false},
        {"key": "category", "label": "類型", "core": false},
        {"key": "contact", "label": "主要聯絡人", "core": false},
        {"key": "phone", "label": "電話", "core": false},
        {"key": "currency", "label": "幣別", "core": false},
        {"key": "paymentTerms", "label": "付款條件", "core": false},
        {"key": "active", "label": "狀態", "core": true}
      ]
    },
    "pages": [
      {
        "page": "suppliers.html",
        "lists": [
          {"key": "suppliers", "label": "供應商清單", "entity": "supplier", "columns": [
            {"field": "name", "visible": true},
            {"field": "alias", "visible": true},
            {"field": "taxId", "visible": true},
            {"field": "category", "visible": true},
            {"field": "contact", "visible": true},
            {"field": "phone", "visible": true},
            {"field": "currency", "visible": true},
            {"field": "paymentTerms", "visible": true},
            {"field": "active", "visible": true}
          ]}
        ],
        "forms": [],
        "actions": [],
        "menus": [],
        "exports": []
      }
    ],
    "outputs": []
  },
  "customization_note": "搬遷時沒有宣告可自訂點（CUSTOMIZATION-SPEC §5）；之後要開放欄位、頁面或輸出的自訂時在這裡加",
  "provides": {
    "api_prefixes": [
      "/api/suppliers",
      "/api/inventory",
      "/api/shipping-notes"
    ],
    "probes": [
      "/api/suppliers",
      "/api/inventory/parts-summary",
      "/api/inventory/batches",
      "/api/shipping-notes",
      "/api/shipping-notes/export-history"
    ]
  },
  "pages": [
    {
      "path": "suppliers.html",
      "menu": {"group": "supply", "label": "供應商管理", "order": 20, "perm": ["procurement"], "active": ["suppliers.html", "supplier-log.html"], "badge": "sb-mod-suppliers"}
    },
    {
      "path": "supplier-log.html"
    },
    {
      "path": "inventory.html",
      "menu": {"group": "supply", "label": "庫存管理", "order": 50, "perm": ["inventory"], "badge": "sb-mod-inventory"}
    },
    {
      "path": "shipping-export-history.html",
      "menu": {"group": "system", "label": "出貨單歷史紀錄", "order": 100, "perm": ["shipping_export_log"]}
    }
  ],
  "system_cards": [
    {
      "id": "shipping-export-history",
      "section": "audit",
      "title": "出貨單歷史紀錄",
      "desc": "出貨單匯出與列印的歷史",
      "impact": "影響：只是查看，不會改動任何資料。",
      "href": "shipping-export-history.html",
      "perm": [
        "shipping_export_log"
      ],
      "order": 20,
      "keywords": "出貨 匯出 歷史",
      "icon": "log"
    }
  ],
  "capabilities": [
    {"key": "supply.supplier.view", "label": "查看供應商", "legacy": {"any": [{"module": "customer"}, {"module": "procurement"}, {"module": "inventory"}]},
     "desc": "可以打開供應商清單與單一供應商（含聯絡人、統一編號與付款條件），以及聯絡人的個資告知紀錄。",
     "impact": "勾選後，這個角色（或這個人）可以看到所有供應商的資料與聯絡人；原本沒有「客戶／採購／庫存」功能勾選的人也會看得到。",
     "question": "{who}可以查看供應商嗎？"},
    {"key": "supply.supplier.create", "label": "新增供應商", "legacy": {"any": [{"module": "customer"}, {"module": "procurement"}, {"module": "inventory"}]},
     "desc": "可以建立新的供應商資料。",
     "impact": "勾選後，可以新增供應商與聯絡人；新增的資料全公司有權查看的人都看得到。",
     "question": "{who}可以新增供應商嗎？"},
    {"key": "supply.supplier.edit", "label": "修改供應商", "legacy": {"any": [{"module": "customer"}, {"module": "procurement"}, {"module": "inventory"}]},
     "desc": "可以修改供應商資料、更新拜訪紀錄，以及登記聯絡人已收到個資告知。",
     "impact": "勾選後，可以更動供應商的內容與聯絡人；修改會留下紀錄，但不會自動通知供應商。",
     "question": "{who}可以修改供應商嗎？"},
    {"key": "supply.supplier.delete", "label": "刪除供應商", "legacy": {"any": [{"module": "customer"}, {"module": "procurement"}, {"module": "inventory"}]},
     "desc": "可以刪除供應商（進入刪除暫存區或依既有規則處理）。",
     "impact": "勾選後，可以刪除供應商資料；放寬這一項需要填原因、等確認期間，並由另一位最高管理者核准。",
     "question": "{who}可以刪除供應商嗎？"}
  ]
}
