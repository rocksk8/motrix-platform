{
  "key": "analytics",
  "name": "營運分析",
  "version": "1.0.44",
  "core": ">=1.0,<2.0",
  "license_key": "analytics",
  "permissions": ["dashboard", "reports", "finance", "equipment", "procurement"],
  "tables": [],
  "tables_note": "本模組不擁有任何表：儀表板與營運報表只讀其他模組的資料（DEPENDENCY-MAP §2 M08）；精算快照過期檢查的「列→金額」經 IP-1 dispatch.row，但**列出有效派工仍直讀 contractor_dispatches、vendor_contractors（M04 的表，唯讀）**——待 M04 公開「有效派工列表」提供者（ROADMAP）",
  "data": {
    "tables": [],
    "files": []
  },
  "provides": {"api_prefixes": ["/api/dashboard", "/api/devices", "/api/materials-summary", "/api/reports"],
               "probes": ["/api/dashboard/stats", "/api/devices", "/api/materials-summary", "/api/reports/ar-aging"]},
  "pages": [
    {"path": "reports.html",
     "menu": {"group": "analysis", "label": "營運報表", "order": 10, "perm": ["finance", "reports"], "badge": "sb-mod-finance"}},
    {"path": "devices.html",
     "menu": {"group": "device", "label": "設備登載", "order": 10, "perm": ["equipment"], "badge": "sb-mod-equipment"}},
    {"path": "warranty.html",
     "menu": {"group": "device", "label": "保固追蹤", "order": 20, "perm": ["equipment"], "badge": "sb-mod-warranty"}},
    {"path": "procurement.html",
     "menu": {"group": "supply", "label": "採購管理", "order": 60, "perm": ["procurement"], "badge": "sb-mod-procurement"}}
  ],
  "customization": {
    "schema": 1,
    "fields": {
      "material": [
        {"key": "name", "label": "品名", "core": true},
        {"key": "model", "label": "廠牌/型號", "core": false},
        {"key": "qty", "label": "數量", "core": false},
        {"key": "unit", "label": "單位", "core": false},
        {"key": "status", "label": "到料狀態", "core": true},
        {"key": "quoteNo", "label": "案件號", "core": true},
        {"key": "customer", "label": "客戶", "core": false},
        {"key": "dealTag", "label": "案件狀態", "core": false},
        {"key": "note", "label": "備註", "core": false}
      ],
      "device": [
        {"key": "name", "label": "設備名稱", "core": true},
        {"key": "sn", "label": "SN 序號", "core": false},
        {"key": "mac", "label": "MAC 位址", "core": false},
        {"key": "customer", "label": "客戶", "core": false},
        {"key": "quoteNo", "label": "案件", "core": false},
        {"key": "location", "label": "安裝地點", "core": false},
        {"key": "warrantyStart", "label": "保固起始", "core": false},
        {"key": "expiryDate", "label": "保固到期", "core": true},
        {"key": "warrantyStatus", "label": "保固狀態", "core": true}
      ]
    },
    "pages": [
      {
        "page": "procurement.html",
        "lists": [
          {"key": "materials", "label": "材料進度清單", "entity": "material", "columns": [
            {"field": "name", "visible": true},
            {"field": "model", "visible": true},
            {"field": "qty", "visible": true},
            {"field": "unit", "visible": true},
            {"field": "status", "visible": true},
            {"field": "quoteNo", "visible": true},
            {"field": "customer", "visible": true},
            {"field": "dealTag", "visible": true},
            {"field": "note", "visible": true}
          ]}
        ],
        "forms": [],
        "actions": [],
        "menus": [],
        "exports": []
      },
      {
        "page": "devices.html",
        "lists": [
          {"key": "devices", "label": "設備清單", "entity": "device", "columns": [
            {"field": "name", "visible": true},
            {"field": "sn", "visible": true},
            {"field": "mac", "visible": true},
            {"field": "customer", "visible": true},
            {"field": "quoteNo", "visible": true},
            {"field": "location", "visible": true},
            {"field": "warrantyStart", "visible": true},
            {"field": "expiryDate", "visible": true},
            {"field": "warrantyStatus", "visible": true}
          ]}
        ],
        "forms": [],
        "actions": [],
        "menus": [],
        "exports": []
      }
    ],
    "outputs": []
  }
}
