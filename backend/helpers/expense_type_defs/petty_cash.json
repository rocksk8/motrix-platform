{
 "name": "零用金支付單",
 "numbering": {
  "prefix": "PC"
 },
 "payable": true,
 "enabled": true,
 "note": "只有支付單：付款方式（零用金／現金／轉帳）由出納登錄付款時決定貸方；不管理零用金餘額。欄位待使用者確認後調整。",
 "fields": [
  {
   "key": "applicant",
   "label": "申請人",
   "type": "ref",
   "target": "users",
   "dataClass": "T1",
   "default": {
    "$": "requester"
   },
   "required": true,
   "locked": true,
   "help": "這一欄會自動帶入申請人；管理者可在設計器解除鎖定"
  },
  {
   "key": "dept",
   "label": "部門",
   "type": "ref",
   "target": "departments",
   "dataClass": "T1",
   "required": true
  },
  {
   "key": "cost_dept",
   "label": "費用歸屬單位",
   "type": "ref",
   "target": "departments",
   "dataClass": "T1",
   "required": false
  },
  {
   "key": "req_date",
   "label": "支付日期",
   "type": "date",
   "dataClass": "T1",
   "default": {
    "$": "today"
   },
   "required": true
  },
  {
   "key": "payee",
   "label": "支付對象／事由",
   "type": "text",
   "dataClass": "T1",
   "required": true,
   "maxLength": 200
  },
  {
   "key": "lines",
   "label": "支付明細",
   "type": "table",
   "dataClass": "T1",
   "required": true,
   "minRows": 1,
   "maxRows": 200,
   "addLabel": "新增一列",
   "columns": [
    {
     "key": "category",
     "label": "費用類別",
     "type": "select",
     "optionsFrom": "expense_categories",
     "required": true
    },
    {
     "key": "summary",
     "label": "摘要",
     "type": "text",
     "required": true
    },
    {
     "key": "amount",
     "label": "金額",
     "type": "number",
     "min": 0,
     "required": true
    },
    {
     "key": "invoiceNo",
     "label": "發票／憑證號碼",
     "type": "text"
    }
   ]
  },
  {
   "key": "total",
   "label": "合計",
   "type": "formula",
   "dataClass": "T1",
   "formula": "total(lines, \"amount\")"
  },
  {
   "key": "remark",
   "label": "備註",
   "type": "textarea",
   "dataClass": "T1",
   "maxLength": 1000
  }
 ],
 "ui": {
  "form": {
   "groups": [
    {
     "title": "基本資料",
     "fields": [
      "applicant",
      "dept",
      "cost_dept",
      "req_date",
      "payee"
     ]
    },
    {
     "title": "支付明細",
     "fields": [
      "lines"
     ]
    },
    {
     "title": "金額",
     "fields": [
      "total"
     ]
    },
    {
     "title": "其他",
     "fields": [
      "remark"
     ]
    }
   ]
  },
  "list": {
   "columns": [
    "applicant",
    "payee",
    "total"
   ]
  }
 },
 "output": {
  "template": {
   "theme": "voucher_standard",
   "blocks": [
    {
     "type": "identity_header",
     "title": "零用金支付單"
    },
    {
     "type": "meta",
     "fields": [
      {
       "label": "單號",
       "path": "recordNo"
      },
      {
       "label": "申請人",
       "path": "fields.applicant"
      },
      {
       "label": "部門",
       "path": "fields.dept"
      },
      {
       "label": "費用歸屬單位",
       "path": "fields.cost_dept"
      },
      {
       "label": "支付日期",
       "path": "fields.req_date"
      },
      {
       "label": "支付對象／事由",
       "path": "fields.payee"
      },
      {
       "label": "備註",
       "path": "fields.remark"
      }
     ]
    },
    {
     "type": "items_table",
     "source": "fields.lines",
     "label": "明細",
     "columns": [
      {
       "title": "#",
       "format": "index"
      },
      {
       "title": "費用類別",
       "path": "category"
      },
      {
       "title": "摘要",
       "path": "summary"
      },
      {
       "title": "金額",
       "path": "amount",
       "format": "money",
       "align": "right"
      },
      {
       "title": "發票／憑證",
       "path": "invoiceNo"
      }
     ]
    },
    {
     "type": "totals",
     "rows": [
      {
       "label": "合計",
       "path": "fields.total",
       "grand": true
      }
     ]
    },
    {
     "type": "approval_sign"
    },
    {
     "type": "identity_footer"
    }
   ]
  }
 }
}
