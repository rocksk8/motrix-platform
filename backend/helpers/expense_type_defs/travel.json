{
 "name": "差旅費用請款單",
 "numbering": {
  "prefix": "TE"
 },
 "payable": true,
 "enabled": true,
 "note": "實報實銷；不綁案件，成本歸屬以「費用歸屬單位」表示；國外差旅先只收台幣。與出差單（事前估算）分開。欄位待使用者確認後調整。",
 "fields": [
  {
   "key": "applicant",
   "label": "申請人",
   "type": "ref",
   "target": "users",
   "dataClass": "T1",
   "default": {
    "$": "requester"
   },
   "required": true,
   "locked": true,
   "help": "預設為登入者；超級管理員可在定義中把 locked 改成 false 讓它可編輯"
  },
  {
   "key": "dept",
   "label": "部門",
   "type": "ref",
   "target": "departments",
   "dataClass": "T1",
   "required": true
  },
  {
   "key": "req_date",
   "label": "申請日期",
   "type": "date",
   "dataClass": "T1",
   "default": {
    "$": "today"
   },
   "required": true
  },
  {
   "key": "place",
   "label": "地點",
   "type": "radio",
   "dataClass": "T1",
   "options": [
    "國內",
    "國外"
   ],
   "default": "國內",
   "required": true
  },
  {
   "key": "city",
   "label": "國家／城市",
   "type": "text",
   "dataClass": "T1",
   "required": true,
   "maxLength": 100
  },
  {
   "key": "cost_dept",
   "label": "費用歸屬單位",
   "type": "ref",
   "target": "departments",
   "dataClass": "T1",
   "required": true
  },
  {
   "key": "period",
   "label": "出差區間",
   "type": "daterange",
   "dataClass": "T1",
   "required": true
  },
  {
   "key": "lines",
   "label": "費用明細",
   "type": "table",
   "dataClass": "T1",
   "required": true,
   "minRows": 1,
   "maxRows": 200,
   "addLabel": "新增一列",
   "columns": [
    {
     "key": "category",
     "label": "費用類別",
     "type": "select",
     "optionsFrom": "expense_categories",
     "required": true
    },
    {
     "key": "summary",
     "label": "品名／摘要",
     "type": "text",
     "required": true
    },
    {
     "key": "qty",
     "label": "數量",
     "type": "number",
     "min": 0,
     "required": true
    },
    {
     "key": "unitCost",
     "label": "單價",
     "type": "number",
     "min": 0,
     "required": true
    },
    {
     "key": "amount",
     "label": "小計",
     "type": "formula",
     "formula": "round_half_up(qty * unitCost)"
    },
    {
     "key": "invoiceNo",
     "label": "發票／憑證號碼",
     "type": "text"
    }
   ]
  },
  {
   "key": "total",
   "label": "總金額",
   "type": "formula",
   "dataClass": "T1",
   "formula": "total(lines, \"amount\")"
  },
  {
   "key": "pay_date",
   "label": "付款日",
   "type": "date",
   "dataClass": "T1",
   "editableBy": "cashier"
  },
  {
   "key": "remark",
   "label": "備註",
   "type": "textarea",
   "dataClass": "T1",
   "maxLength": 1000
  }
 ],
 "ui": {
  "form": {
   "groups": [
    {
     "title": "基本資料",
     "fields": [
      "applicant",
      "dept",
      "req_date"
     ]
    },
    {
     "title": "出差資訊",
     "fields": [
      "place",
      "city",
      "cost_dept",
      "period"
     ]
    },
    {
     "title": "費用明細",
     "fields": [
      "lines"
     ]
    },
    {
     "title": "金額",
     "fields": [
      "total"
     ]
    },
    {
     "title": "其他",
     "fields": [
      "pay_date",
      "remark"
     ]
    }
   ]
  },
  "list": {
   "columns": [
    "applicant",
    "place",
    "city",
    "total"
   ]
  }
 },
 "output": {
  "template": {
   "theme": "voucher_standard",
   "blocks": [
    {
     "type": "identity_header",
     "title": "差旅費用請款單"
    },
    {
     "type": "meta",
     "fields": [
      {
       "label": "單號",
       "path": "recordNo"
      },
      {
       "label": "申請人",
       "path": "fields.applicant"
      },
      {
       "label": "部門",
       "path": "fields.dept"
      },
      {
       "label": "申請日期",
       "path": "fields.req_date"
      },
      {
       "label": "地點",
       "path": "fields.place"
      },
      {
       "label": "國家／城市",
       "path": "fields.city"
      },
      {
       "label": "費用歸屬單位",
       "path": "fields.cost_dept"
      },
      {
       "label": "出差區間",
       "path": "fields.period"
      },
      {
       "label": "備註",
       "path": "fields.remark"
      }
     ]
    },
    {
     "type": "items_table",
     "source": "fields.lines",
     "label": "明細",
     "columns": [
      {
       "title": "#",
       "format": "index"
      },
      {
       "title": "費用類別",
       "path": "category"
      },
      {
       "title": "摘要",
       "path": "summary"
      },
      {
       "title": "數量",
       "path": "qty",
       "align": "right"
      },
      {
       "title": "單價",
       "path": "unitCost",
       "format": "money",
       "align": "right"
      },
      {
       "title": "金額",
       "path": "amount",
       "format": "money",
       "align": "right"
      },
      {
       "title": "發票／憑證",
       "path": "invoiceNo"
      }
     ]
    },
    {
     "type": "totals",
     "rows": [
      {
       "label": "合計",
       "path": "fields.total",
       "grand": true
      }
     ]
    },
    {
     "type": "approval_sign"
    },
    {
     "type": "identity_footer"
    }
   ]
  }
 }
}
