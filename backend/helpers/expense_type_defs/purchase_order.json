{
 "name": "採購單",
 "numbering": {
  "prefix": "PO"
 },
 "payable": true,
 "enabled": true,
 "note": "核准後進出納：匯款日與付款條件由出納填寫。明細一律含稅（稅額欄位之後再開）。欄位待使用者確認後調整。",
 "fields": [
  {
   "key": "applicant",
   "label": "申請人",
   "type": "ref",
   "target": "users",
   "dataClass": "T1",
   "default": {
    "$": "requester"
   },
   "required": true,
   "locked": true,
   "help": "預設為登入者；超級管理員可在定義中把 locked 改成 false 讓它可編輯"
  },
  {
   "key": "dept",
   "label": "部門",
   "type": "ref",
   "target": "departments",
   "dataClass": "T1",
   "required": true
  },
  {
   "key": "req_date",
   "label": "採購日期",
   "type": "date",
   "dataClass": "T1",
   "default": {
    "$": "today"
   },
   "required": true
  },
  {
   "key": "pr_no",
   "label": "請購單號",
   "type": "text",
   "dataClass": "T1",
   "maxLength": 40
  },
  {
   "key": "vendor",
   "label": "廠商",
   "type": "text",
   "dataClass": "T1",
   "required": true,
   "maxLength": 100
  },
  {
   "key": "delivery_date",
   "label": "預計交貨日",
   "type": "date",
   "dataClass": "T1"
  },
  {
   "key": "urgency",
   "label": "緊急程度",
   "type": "select",
   "dataClass": "T1",
   "options": [
    "一般",
    "急件",
    "特急"
   ],
   "default": "一般",
   "required": true
  },
  {
   "key": "remark",
   "label": "備註",
   "type": "textarea",
   "dataClass": "T1",
   "maxLength": 1000
  },
  {
   "key": "lines",
   "label": "採購明細",
   "type": "table",
   "dataClass": "T1",
   "required": true,
   "minRows": 1,
   "maxRows": 200,
   "addLabel": "新增一列",
   "columns": [
    {
     "key": "category",
     "label": "費用類別",
     "type": "select",
     "optionsFrom": "expense_categories",
     "required": true
    },
    {
     "key": "summary",
     "label": "品名／摘要",
     "type": "text",
     "required": true
    },
    {
     "key": "qty",
     "label": "數量",
     "type": "number",
     "min": 0,
     "required": true
    },
    {
     "key": "unitCost",
     "label": "單價",
     "type": "number",
     "min": 0,
     "required": true
    },
    {
     "key": "amount",
     "label": "小計",
     "type": "formula",
     "formula": "round_half_up(qty * unitCost)"
    },
    {
     "key": "invoiceNo",
     "label": "發票／憑證號碼",
     "type": "text"
    }
   ]
  },
  {
   "key": "total",
   "label": "含稅合計",
   "type": "formula",
   "dataClass": "T1",
   "formula": "total(lines, \"amount\")"
  },
  {
   "key": "pay_terms",
   "label": "付款條件",
   "type": "text",
   "dataClass": "T1",
   "editableBy": "cashier",
   "maxLength": 200
  },
  {
   "key": "remit_date",
   "label": "匯款日",
   "type": "date",
   "dataClass": "T1",
   "editableBy": "cashier"
  }
 ],
 "ui": {
  "form": {
   "groups": [
    {
     "title": "基本資料",
     "fields": [
      "applicant",
      "dept",
      "req_date",
      "urgency"
     ]
    },
    {
     "title": "採購資訊",
     "fields": [
      "pr_no",
      "vendor",
      "delivery_date",
      "remark"
     ]
    },
    {
     "title": "採購明細",
     "fields": [
      "lines"
     ]
    },
    {
     "title": "金額",
     "fields": [
      "total"
     ]
    },
    {
     "title": "出納填寫",
     "fields": [
      "pay_terms",
      "remit_date"
     ]
    }
   ]
  },
  "list": {
   "columns": [
    "applicant",
    "vendor",
    "pr_no",
    "total"
   ]
  }
 },
 "output": {
  "template": {
   "theme": "voucher_standard",
   "blocks": [
    {
     "type": "identity_header",
     "title": "採購單"
    },
    {
     "type": "meta",
     "fields": [
      {
       "label": "單號",
       "path": "recordNo"
      },
      {
       "label": "申請人",
       "path": "fields.applicant"
      },
      {
       "label": "部門",
       "path": "fields.dept"
      },
      {
       "label": "採購日期",
       "path": "fields.req_date"
      },
      {
       "label": "請購單號",
       "path": "fields.pr_no"
      },
      {
       "label": "廠商",
       "path": "fields.vendor"
      },
      {
       "label": "預計交貨日",
       "path": "fields.delivery_date"
      },
      {
       "label": "付款條件",
       "path": "fields.pay_terms"
      },
      {
       "label": "匯款日",
       "path": "fields.remit_date"
      },
      {
       "label": "備註",
       "path": "fields.remark"
      }
     ]
    },
    {
     "type": "items_table",
     "source": "fields.lines",
     "label": "明細",
     "columns": [
      {
       "title": "#",
       "format": "index"
      },
      {
       "title": "費用類別",
       "path": "category"
      },
      {
       "title": "摘要",
       "path": "summary"
      },
      {
       "title": "數量",
       "path": "qty",
       "align": "right"
      },
      {
       "title": "單價",
       "path": "unitCost",
       "format": "money",
       "align": "right"
      },
      {
       "title": "金額",
       "path": "amount",
       "format": "money",
       "align": "right"
      },
      {
       "title": "發票／憑證",
       "path": "invoiceNo"
      }
     ]
    },
    {
     "type": "totals",
     "rows": [
      {
       "label": "合計",
       "path": "fields.total",
       "grand": true
      }
     ]
    },
    {
     "type": "approval_sign"
    },
    {
     "type": "identity_footer"
    }
   ]
  }
 }
}
