{
 "key": "business_trip",
 "name": "出差單",
 "category": "人資",
 "description": "申請人、同行人員、目的地、出差起訖、事由與預估費用（交通／住宿／餐費／雜支）；預估合計為支出。",
 "note": "預估費用依申請日認列權責、付款日認列現金；實報實銷請另以請款單登記，避免重複計入。",
 "body": {
  "name": "出差單",
  "icon": "",
  "menu": {
   "group": "人資",
   "order": 62
  },
  "numbering": {
   "prefix": "BT",
   "date": "YYYYMMDD",
   "digits": 4
  },
  "fields": [
   {
    "key": "applicant",
    "label": "申請人",
    "type": "ref",
    "dataClass": "T1",
    "target": "users",
    "default": {
     "$": "requester"
    },
    "required": true
   },
   {
    "key": "dept",
    "label": "部門",
    "type": "ref",
    "dataClass": "T1",
    "target": "departments"
   },
   {
    "key": "travelers",
    "label": "同行人員",
    "type": "ref",
    "dataClass": "T1",
    "target": "users",
    "multiple": true
   },
   {
    "key": "dest",
    "label": "目的地",
    "type": "text",
    "dataClass": "T1",
    "required": true
   },
   {
    "key": "period",
    "label": "出差起訖",
    "type": "daterange",
    "dataClass": "T1",
    "withTime": false,
    "required": true
   },
   {
    "key": "purpose",
    "label": "事由",
    "type": "textarea",
    "dataClass": "T1",
    "maxLength": 500
   },
   {
    "key": "req_date",
    "label": "申請日",
    "type": "date",
    "dataClass": "T1",
    "default": {
     "$": "today"
    }
   },
   {
    "key": "expenses",
    "label": "預估費用",
    "type": "table",
    "dataClass": "T1",
    "minRows": 0,
    "maxRows": 100,
    "addLabel": "新增一列",
    "columns": [
     {
      "key": "item",
      "label": "項目",
      "type": "select",
      "options": [
       "交通",
       "住宿",
       "餐費",
       "雜支"
      ],
      "allowOther": true,
      "required": true
     },
     {
      "key": "note",
      "label": "說明",
      "type": "text"
     },
     {
      "key": "amt",
      "label": "金額",
      "type": "number",
      "min": 0
     }
    ]
   },
   {
    "key": "est_total",
    "label": "預估費用合計",
    "type": "formula",
    "dataClass": "T1",
    "formula": "total(expenses, \"amt\")",
    "finance": {
     "kind": "expense",
     "dateField": "req_date",
     "cashDateField": "pay_date"
    }
   },
   {
    "key": "pay_date",
    "label": "付款日",
    "type": "date",
    "dataClass": "T1",
    "help": "現金口徑的歸屬日期（實際付款後填）"
   }
  ],
  "workflow": {
   "initial": "draft",
   "states": [
    {
     "key": "draft",
     "label": "草稿"
    },
    {
     "key": "pending",
     "label": "簽核中",
     "approval": {
      "tiers": [
       {
        "approvers": [
         {
          "sourceType": "submitter_manager"
         }
        ]
       }
      ],
      "on_approved": "approved",
      "on_rejected": "draft"
     }
    },
    {
     "key": "approved",
     "label": "已核准",
     "final": true,
     "notify": {
      "requester": true
     }
    }
   ],
   "transitions": [
    {
     "key": "submit",
     "label": "送審",
     "from": "draft",
     "to": "pending"
    }
   ]
  },
  "ui": {
   "form": {
    "groups": [
     {
      "title": "出差資訊",
      "fields": [
       "applicant",
       "dept",
       "travelers",
       "dest",
       "period",
       "purpose",
       "req_date"
      ]
     },
     {
      "title": "預估費用",
      "fields": [
       "expenses",
       "est_total",
       "pay_date"
      ]
     }
    ]
   },
   "list": {
    "columns": [
     "applicant",
     "dest",
     "period",
     "est_total"
    ]
   }
  },
  "output": {
   "template": {
    "theme": "voucher_standard",
    "blocks": [
     {
      "type": "identity_header",
      "title": "出差單"
     },
     {
      "type": "meta",
      "fields": [
       {
        "label": "單號",
        "path": "recordNo"
       },
       {
        "label": "申請人",
        "path": "fields.applicant"
       },
       {
        "label": "部門",
        "path": "fields.dept"
       },
       {
        "label": "同行人員",
        "path": "fields.travelers"
       },
       {
        "label": "目的地",
        "path": "fields.dest"
       },
       {
        "label": "出差起訖",
        "path": "fields.period"
       },
       {
        "label": "事由",
        "path": "fields.purpose"
       }
      ]
     },
     {
      "type": "items_table",
      "source": "fields.expenses",
      "label": "預估費用",
      "columns": [
       {
        "title": "#",
        "format": "index"
       },
       {
        "title": "項目",
        "path": "item"
       },
       {
        "title": "說明",
        "path": "note"
       },
       {
        "title": "金額",
        "path": "amt",
        "format": "money",
        "align": "right"
       }
      ]
     },
     {
      "type": "totals",
      "rows": [
       {
        "label": "預估合計",
        "path": "fields.est_total",
        "grand": true
       }
      ]
     },
     {
      "type": "approval_sign"
     },
     {
      "type": "identity_footer"
     }
    ]
   }
  }
 }
}
