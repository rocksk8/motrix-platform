{
 "key": "travel_expense",
 "name": "差旅費用請款單",
 "category": "人資",
 "description": "申請人、部門、申請日期、地點（國內／國外）、國家／城市、費用歸屬單位、出差區間，費用明細（科目、單價、數量、金額、發票號碼）與總金額；總金額為支出。",
 "note": "草稿範本（待使用者回答開放問題後定稿）：核准後總金額列入營運報表支出（權責依申請日、現金依付款日）；不需綁案件，成本歸屬以「費用歸屬單位」（部門）表示。與「出差單」（事前估算）分開：本單是實報實銷，勿重複登記。付款日目前由單據自行填（之後改由出納撥款寫入）。",
 "body": {
  "name": "差旅費用請款單",
  "icon": "",
  "menu": {
   "group": "人資",
   "order": 63
  },
  "numbering": {
   "prefix": "TE",
   "date": "YYYYMMDD",
   "digits": 4
  },
  "fields": [
   {
    "key": "applicant",
    "label": "申請人",
    "type": "ref",
    "dataClass": "T1",
    "target": "users",
    "default": {
     "$": "requester"
    },
    "required": true,
    "help": "預設為登入者；可依公司狀況在定義中設定此欄位是否可編輯"
   },
   {
    "key": "dept",
    "label": "部門",
    "type": "ref",
    "dataClass": "T1",
    "target": "departments",
    "required": true
   },
   {
    "key": "req_date",
    "label": "申請日期",
    "type": "date",
    "dataClass": "T1",
    "default": {
     "$": "today"
    },
    "required": true
   },
   {
    "key": "place",
    "label": "地點",
    "type": "radio",
    "dataClass": "T1",
    "options": [
     "國內",
     "國外"
    ],
    "required": true
   },
   {
    "key": "city",
    "label": "國家/城市",
    "type": "text",
    "dataClass": "T1",
    "required": true
   },
   {
    "key": "cost_dept",
    "label": "費用歸屬單位",
    "type": "ref",
    "dataClass": "T1",
    "target": "departments",
    "required": true,
    "help": "成本歸屬的部門（沒有綁案件時的成本中心）"
   },
   {
    "key": "period",
    "label": "出差區間",
    "type": "daterange",
    "dataClass": "T1",
    "withTime": false,
    "required": true
   },
   {
    "key": "lines",
    "label": "費用明細",
    "type": "table",
    "dataClass": "T1",
    "required": true,
    "minRows": 1,
    "maxRows": 200,
    "addLabel": "新增",
    "columns": [
     {
      "key": "item",
      "label": "科目",
      "type": "select",
      "options": [
       "交通費-停車費",
       "交通費-油資、購票費用",
       "住宿費",
       "高速公路過路費",
       "停車費"
      ],
      "allowOther": true,
      "required": true
     },
     {
      "key": "price",
      "label": "單價",
      "type": "number",
      "min": 0,
      "required": true
     },
     {
      "key": "qty",
      "label": "數量",
      "type": "number",
      "min": 0,
      "required": true
     },
     {
      "key": "amt",
      "label": "金額",
      "type": "formula",
      "formula": "price * qty"
     },
     {
      "key": "invoice_no",
      "label": "發票號碼（收據填『收據』）",
      "type": "text",
      "required": true
     }
    ]
   },
   {
    "key": "total",
    "label": "總金額",
    "type": "formula",
    "dataClass": "T1",
    "formula": "total(lines, \"amt\")",
    "finance": {
     "kind": "expense",
     "dateField": "req_date",
     "cashDateField": "pay_date",
     "cashAmountField": "total"
    }
   },
   {
    "key": "pay_date",
    "label": "付款日",
    "type": "date",
    "dataClass": "T1",
    "help": "現金口徑的歸屬日期（實際付款後填；之後改由出納撥款寫入）"
   },
   {
    "key": "notes",
    "label": "備註",
    "type": "textarea",
    "dataClass": "T1",
    "maxLength": 1000
   }
  ],
  "workflow": {
   "initial": "draft",
   "states": [
    {
     "key": "draft",
     "label": "草稿"
    },
    {
     "key": "pending",
     "label": "簽核中",
     "approval": {
      "tiers": [
       {
        "approvers": [
         {
          "sourceType": "submitter_manager"
         }
        ]
       }
      ],
      "on_approved": "approved",
      "on_rejected": "draft"
     }
    },
    {
     "key": "approved",
     "label": "已核准",
     "final": true,
     "notify": {
      "requester": true
     }
    }
   ],
   "transitions": [
    {
     "key": "submit",
     "label": "送審",
     "from": "draft",
     "to": "pending"
    }
   ]
  },
  "ui": {
   "form": {
    "groups": [
     {
      "title": "基本資料",
      "fields": [
       "applicant",
       "dept",
       "req_date"
      ]
     },
     {
      "title": "出差資訊",
      "fields": [
       "place",
       "city",
       "cost_dept",
       "period"
      ]
     },
     {
      "title": "費用明細",
      "fields": [
       "lines",
       "total"
      ]
     },
     {
      "title": "付款",
      "fields": [
       "pay_date",
       "notes"
      ]
     }
    ]
   },
   "list": {
    "columns": [
     "applicant",
     "city",
     "period",
     "total"
    ]
   }
  },
  "output": {
   "template": {
    "theme": "voucher_standard",
    "blocks": [
     {
      "type": "identity_header",
      "title": "差旅費用請款單"
     },
     {
      "type": "meta",
      "fields": [
       {
        "label": "單號",
        "path": "recordNo"
       },
       {
        "label": "申請人",
        "path": "fields.applicant"
       },
       {
        "label": "部門",
        "path": "fields.dept"
       },
       {
        "label": "申請日期",
        "path": "fields.req_date",
        "format": "date10"
       },
       {
        "label": "地點",
        "path": "fields.place"
       },
       {
        "label": "國家/城市",
        "path": "fields.city"
       },
       {
        "label": "費用歸屬單位",
        "path": "fields.cost_dept"
       },
       {
        "label": "出差區間",
        "path": "fields.period"
       }
      ]
     },
     {
      "type": "items_table",
      "source": "fields.lines",
      "label": "費用明細",
      "columns": [
       {
        "title": "#",
        "format": "index"
       },
       {
        "title": "科目",
        "path": "item"
       },
       {
        "title": "單價",
        "path": "price",
        "format": "money",
        "align": "right"
       },
       {
        "title": "數量",
        "path": "qty",
        "align": "right"
       },
       {
        "title": "金額",
        "path": "amt",
        "format": "money",
        "align": "right"
       },
       {
        "title": "發票號碼",
        "path": "invoice_no"
       }
      ]
     },
     {
      "type": "totals",
      "rows": [
       {
        "label": "總金額",
        "path": "fields.total",
        "grand": true
       }
      ]
     },
     {
      "type": "approval_sign"
     },
     {
      "type": "identity_footer"
     }
    ]
   }
  }
 }
}
