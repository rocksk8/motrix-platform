{
 "key": "purchase_request",
 "name": "請購單",
 "category": "採購",
 "description": "申請人、部門、填表日期、採購類型、採購備註、緊急程度、需求日期區間、請購明細（品名、數量、單位、單價、小計、用途）、總計（未稅／應稅）。",
 "note": "草稿範本（待使用者回答開放問題後定稿）：請購單只是核准文件，不產生付款，也不列入營運報表支出；採購單以「請購單號」引用。「申請人」預設帶登入者，超級管理員可在定義裡改成不可編輯或可改。總計（應稅）目前以未稅×1.05 計算（待確認定義）。",
 "body": {
  "name": "請購單",
  "icon": "",
  "menu": {
   "group": "採購",
   "order": 58
  },
  "numbering": {
   "prefix": "RQ",
   "date": "YYYYMMDD",
   "digits": 4
  },
  "fields": [
   {
    "key": "applicant",
    "label": "申請人",
    "type": "ref",
    "dataClass": "T1",
    "target": "users",
    "default": {
     "$": "requester"
    },
    "required": true,
    "help": "預設為登入者；可依公司狀況在定義中設定此欄位是否可編輯"
   },
   {
    "key": "dept",
    "label": "部門",
    "type": "ref",
    "dataClass": "T1",
    "target": "departments",
    "required": true
   },
   {
    "key": "fill_date",
    "label": "填表日期",
    "type": "date",
    "dataClass": "T1",
    "default": {
     "$": "today"
    },
    "required": true
   },
   {
    "key": "ptype",
    "label": "採購類型",
    "type": "select",
    "dataClass": "T1",
    "options": [
     "測試用設備",
     "案件追加設備、零件",
     "辦公庶務用品",
     "其他"
    ],
    "default": "測試用設備",
    "required": true
   },
   {
    "key": "remark",
    "label": "採購備註說明",
    "type": "textarea",
    "dataClass": "T1",
    "maxLength": 1000,
    "required": true
   },
   {
    "key": "urgency",
    "label": "緊急程度",
    "type": "select",
    "dataClass": "T1",
    "options": [
     "一般",
     "急件",
     "特急"
    ],
    "default": "一般",
    "required": true
   },
   {
    "key": "need_period",
    "label": "需求日期",
    "type": "daterange",
    "dataClass": "T1",
    "withTime": false,
    "required": true
   },
   {
    "key": "lines",
    "label": "請購明細",
    "type": "table",
    "dataClass": "T1",
    "required": true,
    "minRows": 1,
    "maxRows": 200,
    "addLabel": "新增",
    "columns": [
     {
      "key": "name",
      "label": "品名",
      "type": "text",
      "required": true
     },
     {
      "key": "qty",
      "label": "數量",
      "type": "number",
      "min": 0,
      "required": true
     },
     {
      "key": "unit",
      "label": "單位",
      "type": "select",
      "options": [
       "式",
       "組",
       "米",
       "台",
       "套",
       "個",
       "批"
      ],
      "allowOther": true,
      "required": true
     },
     {
      "key": "price",
      "label": "單價",
      "type": "number",
      "min": 0,
      "required": true
     },
     {
      "key": "amt",
      "label": "小計",
      "type": "formula",
      "formula": "qty * price"
     },
     {
      "key": "usage",
      "label": "用途",
      "type": "text"
     }
    ]
   },
   {
    "key": "total_net",
    "label": "總計(未稅)",
    "type": "formula",
    "dataClass": "T1",
    "formula": "total(lines, \"amt\")"
   },
   {
    "key": "total_tax",
    "label": "總計(應稅)",
    "type": "formula",
    "dataClass": "T1",
    "formula": "round_half_up(total_net * 1.05)",
    "help": "未稅×1.05（稅率固定 5%，待確認）"
   }
  ],
  "workflow": {
   "initial": "draft",
   "states": [
    {
     "key": "draft",
     "label": "草稿"
    },
    {
     "key": "pending",
     "label": "簽核中",
     "approval": {
      "tiers": [
       {
        "approvers": [
         {
          "sourceType": "submitter_manager"
         }
        ]
       }
      ],
      "on_approved": "approved",
      "on_rejected": "draft"
     }
    },
    {
     "key": "approved",
     "label": "已核准",
     "final": true,
     "notify": {
      "requester": true
     }
    }
   ],
   "transitions": [
    {
     "key": "submit",
     "label": "送審",
     "from": "draft",
     "to": "pending"
    }
   ]
  },
  "ui": {
   "form": {
    "groups": [
     {
      "title": "基本資料",
      "fields": [
       "applicant",
       "dept",
       "fill_date"
      ]
     },
     {
      "title": "採購資訊",
      "fields": [
       "ptype",
       "remark",
       "urgency",
       "need_period"
      ]
     },
     {
      "title": "請購明細",
      "fields": [
       "lines"
      ]
     },
     {
      "title": "金額",
      "fields": [
       "total_net",
       "total_tax"
      ]
     }
    ]
   },
   "list": {
    "columns": [
     "applicant",
     "dept",
     "ptype",
     "total_tax"
    ]
   }
  },
  "output": {
   "template": {
    "theme": "voucher_standard",
    "blocks": [
     {
      "type": "identity_header",
      "title": "請購單"
     },
     {
      "type": "meta",
      "fields": [
       {
        "label": "單號",
        "path": "recordNo"
       },
       {
        "label": "申請人",
        "path": "fields.applicant"
       },
       {
        "label": "部門",
        "path": "fields.dept"
       },
       {
        "label": "填表日期",
        "path": "fields.fill_date",
        "format": "date10"
       },
       {
        "label": "採購類型",
        "path": "fields.ptype"
       },
       {
        "label": "緊急程度",
        "path": "fields.urgency"
       },
       {
        "label": "需求日期",
        "path": "fields.need_period"
       },
       {
        "label": "採購備註",
        "path": "fields.remark"
       }
      ]
     },
     {
      "type": "items_table",
      "source": "fields.lines",
      "label": "請購明細",
      "columns": [
       {
        "title": "#",
        "format": "index"
       },
       {
        "title": "品名",
        "path": "name"
       },
       {
        "title": "數量",
        "path": "qty",
        "align": "right"
       },
       {
        "title": "單位",
        "path": "unit"
       },
       {
        "title": "單價",
        "path": "price",
        "format": "money",
        "align": "right"
       },
       {
        "title": "小計",
        "path": "amt",
        "format": "money",
        "align": "right"
       },
       {
        "title": "用途",
        "path": "usage"
       }
      ]
     },
     {
      "type": "totals",
      "rows": [
       {
        "label": "總計（未稅）",
        "path": "fields.total_net"
       },
       {
        "label": "總計（應稅）",
        "path": "fields.total_tax",
        "grand": true
       }
      ]
     },
     {
      "type": "approval_sign"
     },
     {
      "type": "identity_footer"
     }
    ]
   }
  }
 }
}
