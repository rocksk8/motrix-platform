{
  "v": 1,
  "note": "sale 包剪裁與投影設定（docs/platform/SALE-PACKAGE-DEID.md §2.3；工具 tools/platform/deid_project.py）。own 包不套用本檔。",
  "manifest_baseline": "2026-09-30g",
  "remove": [
    "docs/**",
    ".claude/**",
    ".gitattributes",
    ".gitignore",
    "backend/pytest.ini",
    "tools/platform/**",
    "product/sale_docs/**",
    "backend/setup_heartbeat_task.ps1",
    "product/sale_files/**"
  ],
  "keep": [
    "tools/platform/upgrade.py",
    "tools/platform/module_update.py",
    "tools/platform/product_select.py",
    "tools/platform/ship_tier.py"
  ],
  "forbidden": [
    "docs/**",
    ".claude/**",
    "NEXT-SESSION.md",
    "MULTIWIN-PROTOCOL.md",
    "AGENT-HANDOFF-TEMPLATE.md",
    "CHANGELOG.md",
    "MOTRIX-ERP-*.md",
    "*-AUDIT-*.md",
    "WEEKLY-AUDIT-*.md",
    "*-PLAN*.md",
    "*-DESIGN.md",
    "*-SPEC.md",
    "GITFLOW.md",
    "AUTOLOGON-FIX.md",
    "PASSKEY-CA-ROLLOUT.md",
    "backend/migrations_frozen/own_payload.json",
    "tools/platform/deid_*",
    "tools/platform/own_payload.py",
    "tools/platform/fail_stream.py",
    "tools/platform/modtest.py",
    "tools/platform/*drill*.py",
    "backend/tests/**",
    "product/sale_docs/**",
    "backend/setup_heartbeat_task.ps1",
    "product/sale_files/**"
  ],
  "cuts": [
    {
      "path": "backend/core/upgrade.py",
      "name": "v9-company-defaults",
      "stub": "# sale 包：不含任何公司預設值（升級精靈不回填公司資料；本段在 own 包才有）。\nV9_COMPANY_DEFAULTS = {}"
    },
    {
      "path": "backend/core/upgrade.py",
      "name": "is-our-install",
      "stub": "def _is_our_install(profile: dict) -> bool:\n    return False          # sale 包：沒有「本公司安裝」這回事，一律不回填"
    },
    {
      "path": "backend/tools/apply_update.ps1",
      "name": "prod-root",
      "stub": ". (Join-Path $PSScriptRoot \"_install_root.ps1\")\n$InstallRootInfo = Resolve-InstallRoot $PSScriptRoot\n$ProdRoot = $InstallRootInfo.Root\n$Port = $InstallRootInfo.Port"
    },
    {
      "path": "backend/tools/apply_update.ps1",
      "name": "prod-guard",
      "stub": "if ($InstallRootInfo.Error) {\n    Fail (\"這裡不是可以套用更新的安裝目錄：\" + $InstallRootInfo.Error) \"not_prod_machine\"\n}\nInfo \"身分確認：安裝目錄（$ProdRoot）`n\""
    },
    {
      "path": "backend/tools/rollback_update.ps1",
      "name": "prod-root",
      "stub": ". (Join-Path $PSScriptRoot \"_install_root.ps1\")\n$InstallRootInfo = Resolve-InstallRoot $PSScriptRoot\n$ProdRoot = $InstallRootInfo.Root\n$Port = $InstallRootInfo.Port"
    },
    {
      "path": "backend/tools/rollback_update.ps1",
      "name": "prod-guard",
      "stub": "if ($InstallRootInfo.Error) {\n    Fail (\"這裡不是可以套用更新的安裝目錄：\" + $InstallRootInfo.Error) \"rollback_not_prod_machine\"\n}\nInfo \"身分確認：安裝目錄（$ProdRoot）`n\""
    },
    {
      "path": "backend/tools/apply_module_update.ps1",
      "name": "prod-root",
      "stub": ". (Join-Path $PSScriptRoot \"_install_root.ps1\")\n$InstallRootInfo = Resolve-InstallRoot $PSScriptRoot\n$ProdRoot = $InstallRootInfo.Root\n$Port = $InstallRootInfo.Port"
    },
    {
      "path": "backend/tools/apply_module_update.ps1",
      "name": "prod-guard",
      "stub": "if ($InstallRootInfo.Error) {\n    Fail (\"這裡不是可以套用更新的安裝目錄：\" + $InstallRootInfo.Error) \"not_prod_machine\"\n}\nInfo \"身分確認：安裝目錄（$ProdRoot）`n\""
    },
    {
      "path": "backend/setup_autostart_task.ps1",
      "name": "prod-root",
      "stub": ". (Join-Path $BackendDir \"tools\\_install_root.ps1\")\n$InstallRootInfo = Test-InstallRoot -Root (Split-Path -Parent $BackendDir)\n$ProdRoot = $InstallRootInfo.Root\nif ($InstallRootInfo.Error) {\n    Write-Error (\"這裡不是可以註冊排程的安裝目錄：\" + $InstallRootInfo.Error + \"。中止，未做任何變更。\")\n    exit 1\n}"
    }
  ],
  "replace": {
    "DEPLOY.md": "product/sale_docs/DEPLOY.md",
    "DR-SOP.md": "product/sale_docs/DR-SOP.md",
    "HTTPS-DEPLOY-CHECKLIST.md": "product/sale_docs/HTTPS-DEPLOY-CHECKLIST.md",
    "backend/autostart.bat": "product/sale_files/autostart.bat"
  },
  "require_text": {
    "DEPLOY.md": "<安裝目錄>",
    "DR-SOP.md": "<安裝目錄>",
    "HTTPS-DEPLOY-CHECKLIST.md": "<安裝目錄>",
    "backend/autostart.bat": "%~dp0"
  },
  "rehash": [
    {
      "script": "backend/tools/apply_update.ps1",
      "registry": "backend/tools/apply_update.version.json"
    },
    {
      "script": "backend/tools/apply_module_update.ps1",
      "registry": "backend/tools/apply_module_update.version.json"
    }
  ]
}
